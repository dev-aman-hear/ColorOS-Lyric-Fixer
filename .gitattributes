# Set default behavior to automatically normalize line endings
* text=auto

# Enforce strictly LF line endings for all scripts and Android flashable files
*.sh text eol=lf
*.prop text eol=lf
update-binary text eol=lf
updater-script text eol=lf
*.xml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.db binary
*.zip binary
